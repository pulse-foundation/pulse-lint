{
  "singleQuote": true,
  "jsxSingleQuote": true,
  "sortImports": {
    "customGroups": [
      {
        "groupName": "pulse",
        "elementNamePattern": ["@pulse", "@pulse/**"]
      },
      {
        "groupName": "alias",
        "elementNamePattern": ["@/**"]
      },
      {
        "groupName": "hash",
        "elementNamePattern": ["#*", "#*/**"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "pulse",
      "alias",
      "hash",
      "parent",
      ["sibling", "index"],
      "style",
      "unknown"
    ],
    "sortSideEffects": false
  }
}
