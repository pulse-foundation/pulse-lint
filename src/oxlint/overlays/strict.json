{
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 220,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.mjs",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "no-await-in-loop": "off"
      }
    }
  ]
}
