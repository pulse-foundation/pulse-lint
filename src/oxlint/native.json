{
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "extends": ["./base.json", "./best-practices.json", "./node.json", "./react.json"],
  "jsPlugins": ["./plugins/pulse-naming.js", "eslint-plugin-n", "./plugins/pulse-native.js"],
  "ignorePatterns": [
    "ios/**",
    "android/**",
    "dist/**",
    ".expo/**",
    "coverage/**",
    "node_modules/**",
    "**/generated/**",
    "**/storybook.requires.ts"
  ],
  "rules": {
    "no-void": "off",
    "no-bitwise": "off",
    "no-console": "error",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".tsx"],
        "allow": "as-needed"
      }
    ],
    "pulse-naming/folder-naming-convention": "off",
    "pulse-naming/filename-naming-convention": "off",
    "pulse-native/filename-convention": "error",
    "pulse-native/no-cross-feature-deep-import": "error",
    "pulse-native/no-memo-comparator": "error",
    "pulse-native/no-raw-jsx-text": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "isFinite",
        "message": "Use Number.isFinite instead."
      },
      {
        "name": "isNaN",
        "message": "Use Number.isNaN instead."
      },
      {
        "name": "document",
        "message": "No DOM in React Native code."
      },
      {
        "name": "window",
        "message": "No browser globals in React Native code."
      },
      {
        "name": "localStorage",
        "message": "Use the platform storage adapters."
      },
      {
        "name": "sessionStorage",
        "message": "Use the platform storage adapters."
      },
      {
        "name": "indexedDB",
        "message": "Use the platform storage adapters."
      },
      {
        "name": "location",
        "message": "Use Expo Router / Linking."
      },
      {
        "name": "history",
        "message": "Use Expo Router."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "lodash",
            "message": "Import specific parts of \"lodash\" explicitly, for example: `import isEqual from \"lodash/isEqual\"`."
          },
          {
            "name": "react-dom",
            "message": "No DOM in React Native code."
          },
          {
            "name": "react-native-web",
            "message": "Native code must not depend on react-native-web."
          }
        ],
        "patterns": [
          {
            "group": ["lodash.*"],
            "message": "Import specific parts of \"lodash\" explicitly."
          },
          {
            "group": ["react-dom/*", "**/apps/frontend/**", "@pulse/frontend", "@pulse/frontend/*"],
            "message": "Native code must not import the web app or the DOM; extract portable code to a shared package."
          }
        ]
      }
    ],
    "react/static-components": "error",
    "react/use-memo": "error",
    "react/void-use-memo": "error",
    "react/preserve-manual-memoization": "error",
    "react/incompatible-library": "error",
    "react/immutability": "error",
    "react/globals": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/error-boundaries": "error",
    "react/purity": "error",
    "react/set-state-in-render": "error",
    "react/unsupported-syntax": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.mjs", "**/*.test.js"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.js", "**/*.test.mjs", "test/**"],
      "rules": {
        "react/jsx-filename-extension": "off",
        "pulse-native/no-raw-jsx-text": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "n/global-require": "off",
        "max-lines": "off",
        "max-nested-callbacks": "off"
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "react/jsx-filename-extension": "off"
      }
    },
    {
      "files": ["src/app/dev/**", "src/features/dev/**", "**/*.stories.tsx", ".rnstorybook/**"],
      "rules": {
        "pulse-native/no-raw-jsx-text": "off",
        "pulse-native/no-cross-feature-deep-import": "off",
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.config.js", "**/*.config.ts", "config/**", "plugins/**", "scripts/**"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "no-console": "off",
        "no-await-in-loop": "off",
        "n/global-require": "off",
        "pulse-native/no-raw-jsx-text": "off"
      }
    }
  ]
}
