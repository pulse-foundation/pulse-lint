{
  "name": "@pulse-kit/lint",
  "version": "1.0.1",
  "description": "Pulse linting and formatting configs",
  "license": "GPL-3.0-only",
  "author": "Pulse contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulse-foundation/pulse-lint.git"
  },
  "bin": {
    "pulse-lint": "./dist/cli/index.js"
  },
  "files": [
    "/dist/**",
    "/README.md",
    "/LICENSE",
    "/NOTICE",
    "/docs/preset-comparison.md",
    "/docs/toolchain-upgrade.md",
    "/docs/unsupported-legacy-rules.json",
    "/CHANGELOG.md",
    "/docs/releasing.md"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": "./dist/oxfmt/index.json",
    "./oxlint": "./dist/oxlint/index.json",
    "./oxlint/best-practices": "./dist/oxlint/best-practices.json",
    "./oxlint/imports": "./dist/oxlint/imports.json",
    "./oxlint/node": "./dist/oxlint/node.json",
    "./oxlint/react-a11y": "./dist/oxlint/react-a11y.json",
    "./oxlint/react": "./dist/oxlint/react.json",
    "./oxlint/typescript": "./dist/oxlint/typescript.json",
    "./oxlint/variables": "./dist/oxlint/variables.json",
    "./commitlint": "./dist/commitlint/index.js",
    "./lefthook": "./dist/lefthook/index.yml",
    "./tsconfig": "./dist/tsconfig.json",
    "./oxlint/native": "./dist/oxlint/native.json",
    "./oxlint/strict": "./dist/oxlint/strict.json",
    "./oxlint/base": "./dist/oxlint/base.json",
    "./oxlint/web": "./dist/oxlint/web.json",
    "./oxlint/server": "./dist/oxlint/server.json",
    "./oxlint/server-strict": "./dist/oxlint/server-strict.json",
    "./oxlint/overlays/strict": "./dist/oxlint/overlays/strict.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json && node scripts/prepare-dist.ts",
    "prepack": "yarn build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "yarn lint && yarn typecheck && yarn test:run && yarn test:app",
    "test:import-order": "vitest run ./tests/integration/import-order.test.ts",
    "test:native": "vitest run ./tests/integration/native-lint.test.ts ./tests/integration/native-review.test.ts ./tests/integration/compiler-rules.test.ts",
    "test:strict": "vitest run ./tests/integration/strict-lint.test.ts",
    "test:package": "vitest run ./tests/integration/package.test.ts",
    "test:app": "node ./dist/cli/index.js oxlint ./tests/fixtures/web-app/src && node ./dist/cli/index.js oxfmt:check ./tests/fixtures/web-app",
    "lint": "yarn build && yarn lint:oxlint && yarn format:check",
    "lint:oxlint": "oxlint -c .oxlintrc.json --deny-warnings ./src ./scripts ./tests/unit ./tests/integration ./tests/helpers ./tests/setup.ts ./tests/fixtures/web-app/src ./vitest.config.ts",
    "lint:fix": "yarn build && yarn lint:oxlint --fix && yarn format",
    "format": "oxfmt -c ./src/oxfmt/index.json",
    "format:check": "oxfmt --check -c ./src/oxfmt/index.json",
    "commitlint": "commitlint --config ./dist/commitlint/index.js",
    "lefthook:install": "lefthook install",
    "test:profiles": "vitest run ./tests/integration/profiles.test.ts",
    "test:cli": "vitest run ./tests/integration/cli.test.ts",
    "changeset": "changeset",
    "version:packages": "changeset version && yarn install --mode=skip-build && oxfmt -c src/oxfmt/index.json package.json CHANGELOG.md .changeset",
    "audit:dependencies": "yarn npm audit --all --recursive --severity high",
    "test:release": "vitest run ./tests/unit/release-plan.test.ts ./tests/integration/release-version.test.ts",
    "test:naming": "vitest run ./tests/integration/naming.test.ts",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "eslint-plugin-n": "18.4.1",
    "execa": "10.1.0",
    "lefthook": "2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/types": "21.2.3",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.9",
    "@types/estree-jsx": "1.0.5",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "commitlint": {
    "extends": "./dist/commitlint/index.js"
  },
  "engines": {
    "node": ">=24.13.1"
  },
  "packageManager": "yarn@4.18.1"
}
